# PayPilot environment settings.
# 1. Copy this file and name the copy ".env"  (Windows: copy .env.example .env)
# 2. Fill in the values, save, then restart Expo (Ctrl + C, then npx expo start).
# Never commit .env. These web-config values are not secret, but keep your
# own project details out of public repositories anyway.

# ---- Option A: try everything locally with the Firebase Emulators (free, no Firebase account) ----
# Set to true and run "npm run emulators" in a second terminal.
EXPO_PUBLIC_USE_FIREBASE_EMULATORS=true
# "localhost" for the web browser on this laptop. For Expo Go on a phone,
# use this laptop's Wi-Fi IPv4 address from "ipconfig", e.g. 192.168.1.23
EXPO_PUBLIC_FIREBASE_EMULATOR_HOST=localhost

# ---- Option B: your real Firebase project ----
# Set EXPO_PUBLIC_USE_FIREBASE_EMULATORS=false and paste the values from
# Firebase Console > Project settings > General > Your apps > Web app > SDK setup and configuration.
EXPO_PUBLIC_FIREBASE_API_KEY=your-api-key
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
EXPO_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=your-project-id.firebasestorage.app
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=123456789012
EXPO_PUBLIC_FIREBASE_APP_ID=1:123456789012:web:abcdef1234567890

# Region the Cloud Functions are deployed to (must match functions/index.js).
EXPO_PUBLIC_FIREBASE_FUNCTIONS_REGION=asia-south1
