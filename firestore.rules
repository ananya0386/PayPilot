rules_version = '2';

// PayPilot Firestore security rules.
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() {
      return request.auth != null;
    }

    function isOwner(uid) {
      return signedIn() && request.auth.uid == uid;
    }

    function incoming() {
      return request.resource.data;
    }

    function isDate(value) {
      return value is string && value.matches('^[0-9]{4}-[0-9]{2}-[0-9]{2}$');
    }

    function isNonEmptyText(value, maxLength) {
      return value is string && value.size() > 0 && value.size() <= maxLength;
    }

    // createdAt is set once (by the server clock) and never changes.
    function createdAtOk() {
      return request.method == 'create'
        ? incoming().createdAt == request.time
        : incoming().createdAt == resource.data.createdAt;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid) && validProfile(uid) && createdAtOk();
      allow update: if isOwner(uid) && validProfile(uid) && createdAtOk()
        && incoming().email == resource.data.email;
      allow delete: if false;

      function validProfile(uid) {
        let d = incoming();
        // Added 'expoPushToken' to allowed keys
        return d.keys().hasOnly(['userId', 'name', 'email', 'preferences', 'expoPushToken', 'createdAt', 'updatedAt'])
          && d.keys().hasAll(['userId', 'name', 'email', 'preferences', 'createdAt', 'updatedAt'])
          && d.userId == uid
          && isNonEmptyText(d.name, 60)
          && d.email is string && d.email.size() <= 254
          && (request.method != 'create' || d.email == request.auth.token.email)
          && d.preferences is map
          && d.preferences.keys().hasOnly(['renewalReminders', 'paymentAlerts', 'currency'])
          && d.preferences.get('renewalReminders', true) is bool
          && d.preferences.get('paymentAlerts', true) is bool
          && d.preferences.get('currency', 'INR') == 'INR'
          && (!('expoPushToken' in d) || d.expoPushToken == null || d.expoPushToken is string)
          && d.updatedAt == request.time;
      }

      match /subscriptions/{subscriptionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validSubscription(uid) && createdAtOk();
        allow delete: if isOwner(uid);

        function validSubscription(uid) {
          let d = incoming();
          return d.keys().hasOnly(['userId', 'name', 'category', 'amount', 'currency', 'billingCycle', 'nextDueDate',
                                   'startDate', 'status', 'cancellationUrl', 'reminder', 'autopayEnabled', 'createdAt', 'updatedAt'])
            && d.keys().hasAll(['userId', 'name', 'category', 'amount', 'currency', 'billingCycle', 'nextDueDate',
                                'status', 'reminder', 'autopayEnabled', 'createdAt', 'updatedAt'])
            && d.userId == uid
            && isNonEmptyText(d.name, 60)
            && d.category in ['Entertainment', 'Utilities', 'Software', 'Education', 'Shopping', 'Other']
            && d.amount is number && d.amount > 0 && d.amount <= 1000000
            && d.currency == 'INR'
            && d.billingCycle in ['weekly', 'monthly', 'quarterly', 'yearly']
            && isDate(d.nextDueDate)
            && (!('startDate' in d) || d.startDate == null || isDate(d.startDate))
            && d.status in ['active', 'paused', 'cancelled']
            && (!('cancellationUrl' in d) || (d.cancellationUrl is string && d.cancellationUrl.size() <= 300
                && (d.cancellationUrl == '' || d.cancellationUrl.matches('^https?://.+'))))
            && d.reminder is map
            && d.reminder.keys().hasOnly(['enabled', 'daysBefore'])
            && d.reminder.enabled is bool
            && d.reminder.daysBefore is int && d.reminder.daysBefore >= 0 && d.reminder.daysBefore <= 30
            && d.autopayEnabled is bool
            && d.updatedAt == request.time;
        }
      }

      // One auto-pay rule per subscription; the document id IS the subscription id.
      match /autopayRules/{subscriptionId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid) && validRule(uid, subscriptionId)
          // existsAfter: also true when the subscription is created in the same batch.
          && existsAfter(/databases/$(database)/documents/users/$(uid)/subscriptions/$(subscriptionId));
        allow delete: if isOwner(uid);

        function validRule(uid, subscriptionId) {
          let d = incoming();
          return d.keys().hasOnly(['userId', 'subscriptionId', 'enabled', 'spendingLimit', 'failureAction', 'retry', 'demoAccountId', 'updatedAt'])
            && d.keys().hasAll(['userId', 'subscriptionId', 'enabled', 'spendingLimit', 'failureAction', 'retry', 'demoAccountId', 'updatedAt'])
            && d.userId == uid
            && d.subscriptionId == subscriptionId
            && d.enabled is bool
            && (d.spendingLimit == null || (d.spendingLimit is number && d.spendingLimit > 0 && d.spendingLimit <= 1000000))
            && (!d.enabled || d.spendingLimit != null)
            && d.failureAction in ['retry', 'notify', 'skip']
            && d.retry is map && d.retry.keys().hasOnly(['maxAttempts'])
            && d.retry.maxAttempts is int && d.retry.maxAttempts >= 1 && d.retry.maxAttempts <= 5
            && d.demoAccountId in ['demo-acc-4821', 'demo-card-1092', 'demo-upi-7730']
            && d.updatedAt == request.time;
        }
      }

      // Written ONLY by Cloud Functions (payment simulation). Read-only for the app.
      match /payments/{paymentId} {
        allow read: if isOwner(uid);
        allow write: if false;
      }

      match /notifications/{notificationId} {
        allow read: if isOwner(uid);
        allow create: if isOwner(uid)
          && incoming().keys().hasOnly(['userId', 'type', 'title', 'message', 'subscriptionId', 'isRead', 'createdAt'])
          && incoming().keys().hasAll(['userId', 'type', 'title', 'message', 'subscriptionId', 'isRead', 'createdAt'])
          && incoming().userId == uid
          && incoming().type in ['welcome', 'renewal_reminder', 'autopay_updated']
          && isNonEmptyText(incoming().title, 80)
          && isNonEmptyText(incoming().message, 300)
          && (incoming().subscriptionId == null || incoming().subscriptionId is string)
          && incoming().isRead == false
          && incoming().createdAt == request.time;
        allow update: if isOwner(uid)
          && incoming().diff(resource.data).affectedKeys().hasOnly(['isRead'])
          && incoming().isRead is bool;
        allow delete: if isOwner(uid);
      }

      // Rule-based spending summaries (one per month, id = "YYYY-MM").
      match /summaries/{summaryId} {
        allow read: if isOwner(uid);
        allow create, update: if isOwner(uid)
          && summaryId.matches('^[0-9]{4}-[0-9]{2}$')
          && incoming().keys().hasOnly(['userId', 'month', 'totals', 'categoryBreakdown', 'recommendations', 'generator', 'generatedAt'])
          && incoming().userId == uid
          && incoming().month == summaryId
          && incoming().totals is map
          && incoming().categoryBreakdown is list && incoming().categoryBreakdown.size() <= 10
          && incoming().recommendations is list && incoming().recommendations.size() <= 10
          && incoming().generator == 'rule-based'
          && incoming().generatedAt == request.time;
        allow delete: if isOwner(uid);
      }
    }
  }
}