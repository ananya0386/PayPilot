{
  "name": "paypilot",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "dependencies": {
    "@expo/metro-runtime": "~57.0.16",
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.1.0",
    "expo": "~57.0.31",
    "expo-constants": "~57.0.21",
    "expo-crypto": "~57.0.4",
    "expo-font": "~57.0.4",
    "expo-linking": "~57.0.13",
    "expo-notifications": "~57.0.24",
    "expo-router": "~57.0.29",
    "expo-splash-screen": "~57.0.10",
    "expo-status-bar": "~57.0.1",
    "firebase": "12.19.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.3",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-screens": "~4.26.0",
    "react-native-web": "~0.21.0"
  },
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "emulators": "firebase emulators:start --project demo-paypilot",
    "test:backend": "firebase emulators:exec --project demo-paypilot \"node --test --test-concurrency=1 tests/rules.test.js tests/functions.test.js\"",
    "functions:install": "npm install --prefix functions",
    "deploy:rules": "firebase deploy --only firestore:rules,firestore:indexes",
    "deploy:functions": "firebase deploy --only functions"
  },
  "private": true,
  "description": "PayPilot: subscription and bill tracker (React Native + Expo Router, Firebase Auth + Firestore + Cloud Functions)",
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@firebase/rules-unit-testing": "5.0.2",
    "eslint": "^9.39.5",
    "eslint-config-expo": "~57.0.2",
    "firebase-tools": "15.34.0",
    "globals": "^16.5.0"
  }
}
